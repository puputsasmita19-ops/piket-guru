rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // School Settings (Public read for active app configuration & Kiosk display)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Users collection (Petugas & Pengguna Piket)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Teachers & Staff Master Data
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Rooms & Incident Categories
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /incidentCategories/{catId} {
      allow read, write: if true;
    }

    // Duty Schedules (Jadwal Piket Harian & Mingguan)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Attendance Records (Presensi GPS & Swafoto)
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Duty Books (Jurnal Buku Piket Digital)
    match /dutyBooks/{dutyBookId} {
      allow read, write: if true;
    }

    // Incidents & Incident Photos (Laporan Kejadian)
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    match /documents/{docId} {
      allow read, write: if true;
    }

    // Announcements & Running Ticker
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Student Tardiness (Siswa Terlambat)
    match /studentTardiness/{tardinessId} {
      allow read, write: if true;
    }

    // Teacher Substitutions (Guru Inval / Pengganti)
    match /substitutions/{substitutionId} {
      allow read, write: if true;
    }

    // Student Permits (Izin Meninggalkan Sekolah)
    match /studentPermits/{permitId} {
      allow read, write: if true;
    }

    // Visitors (Buku Tamu Digital)
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    // Audit logs (IMMUTABLE FORENSIC AUDIT TRAIL - NO UPDATES OR DELETES EVER ALLOWED)
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Backups
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Emergencies & Broadcasts (Pusat Siaga Darurat)
    match /emergencies/{emergencyId} {
      allow read, write: if true;
    }

    match /emergency_history/{historyId} {
      allow read, write: if true;
    }

    // Database Snapshots & Disaster Recovery
    match /database_snapshots/{snapshotId} {
      allow read, write: if true;
    }
  }
}


